{
  "name": "practice-player",
  "private": true,
  "version": "1.0.0",
  "license": "Unlicense",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen-test-audio": "bash scripts/gen-test-audio.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15"
  },
  "engines": {
    "node": ">=20.19"
  }
}
